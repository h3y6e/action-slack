{
  "name": "action-slack",
  "version": "4.0.9",
  "description": "You can notify slack of GitHub Actions.",
  "keywords": [
    "actions",
    "chat",
    "node",
    "setup",
    "slack"
  ],
  "license": "MIT",
  "author": "h3y6e",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h3y6e/action-slack.git"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware --max-warnings=0",
    "lint:fix": "oxlint --type-aware --fix-dangerously",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@slack/webhook": "^8.0.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.1.10",
    "msw": "2.15.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "undici": "6.28.0",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  }
}
